<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Разрешение на интернет — обязательно для общения с FastAPI.
        Без этой строки приложение упадёт при первой попытке HTTP-запроса.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ChineseDictApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChineseDictionary"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!--
            android:name=".ChineseDictApplication" — указываем наш Application
            класс с аннотацией @HiltAndroidApp.
            
            android:usesCleartextTraffic="true" — РАЗРЕШАЕМ ОБРАЩЕНИЯ ПО HTTP
            (не HTTPS). Это нужно, потому что наш FastAPI работает по http://10.0.2.2:8000
            без шифрования. По умолчанию Android 9+ запрещает cleartext-трафик
            из соображений безопасности.
            
            ⚠️ В продакшене это нужно убрать и использовать HTTPS. Для дипломного
            проекта на эмуляторе — норма.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ChineseDictionary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
